# API port (the Vite dev server proxies /api to it)
PORT=3000

# MongoDB Atlas connection string. Leave empty to use the local embedded DB (server/.data).
MONGODB_URI=

# Long random string. Required in production.
JWT_SECRET=

# Comma-separated emails that get admin access when they sign in.
ADMIN_EMAILS=

# Public web address. Production: your https domain (the API serves the web app there).
CLIENT_ORIGIN=http://localhost:5173
# Extra origins allowed to call the API / receive the Instagram return (comma-separated).
ALLOWED_ORIGINS=

# Used by the admin-only /api/chat endpoint (AI review helper later).
ANTHROPIC_API_KEY=

# ---- Google sign-in (Firebase) ----
# Firebase console → Project settings → Your apps → Web app → SDK config.
# These are public web settings (safe in the browser). Only VITE_* values reach the web app.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# The server verifies Google sign-ins against this project (defaults to VITE_FIREBASE_PROJECT_ID).
FIREBASE_PROJECT_ID=

# Encrypts stored Instagram tokens. 32 random bytes, base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# ---- Instagram (Instagram API with Instagram Login) ----
# Meta App Dashboard → your Business app → Instagram → API setup with Instagram login.
# Use the *Instagram* app ID and secret shown there (not the Meta app ID).
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Defaults to <CLIENT_ORIGIN>/api/social/instagram/callback. Must exactly match Meta and be https.
# Local testing: run a tunnel (e.g. `ngrok http 5173`) and use https://<tunnel>/api/social/instagram/callback
INSTAGRAM_REDIRECT_URI=
INSTAGRAM_GRAPH_VERSION=v27.0

# ---- YouTube ----
# Google Cloud console (project cliprewards-5293b) → enable "YouTube Data API v3" → Credentials → API key.
# Restrict the key to the YouTube Data API v3. Server-side only.
YOUTUBE_API_KEY=

# Instagram webhooks (optional). Callback URL: https://<host>/api/social/instagram/webhook
# Use any random string here and paste the same value as "Verify token" in Meta.
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=

# ---- Image uploads (Cloudinary) ----
# Cloudinary dashboard → API Keys. Copy the "API environment variable" (cloudinary://key:secret@cloud).
# Without it, admins can still paste image links.
CLOUDINARY_URL=
